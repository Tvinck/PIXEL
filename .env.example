# --- Supabase Database & Auth ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Telegram Bot & Mini App Integration ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
WEB_APP_URL=https://your-app-domain.com
POLLING=false

# --- API Gateway & Server Setup ---
SERVER_URL=https://your-api-domain.com
ALLOW_DEV_AUTH=false

# --- AI Models & External Providers ---
KIE_API_KEY=your-kie-api-key
KIE_WEBHOOK_SECRET=your-kie-webhook-secret
REPLICATE_API_TOKEN=your-replicate-api-token
GEMINI_API_KEY=your-google-gemini-key

# --- Monitoring & Security ---
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
ADMIN_2FA_SECRET=your-totp-secret-base32

# --- OAuth & Payments ---
VITE_YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
